{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "Node16",
        "types": ["node"],
        "strict": true,
        "noEmitOnError": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "inlineSources": true,
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": ["src/**/*.ts"]
}
