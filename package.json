{
    "name": "movingai2json",
    "version": "1.2.0",
    "description": "Convert the MovingAI map and scen format into a JSON data structure.",
    "author": "Davide Aversa <thek3nger@gmail.com>",
    "main": "dist/movingai2json.js",
    "types": "dist/movingai2json.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/movingai2json.d.ts",
                "default": "./dist/esm/movingai2json.js"
            },
            "require": {
                "types": "./dist/movingai2json.d.ts",
                "default": "./dist/movingai2json.js"
            }
        },
        "./package.json": "./package.json",
        "./dist/*": "./dist/*"
    },
    "type": "commonjs",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/THeK3nger/movingai2json"
    },
    "scripts": {
        "pretest": "npm run build && tsc -p tsconfig.test.json",
        "test": "node --enable-source-maps --test --experimental-test-coverage .test-dist/tests.js",
        "build": "tsc && tsc -p tsconfig.esm.json && node scripts/finalize-build.mjs",
        "check": "biome check .",
        "format": "biome format --write .",
        "prepack": "npm run build",
        "start": "node dist/movingai2json.js"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "keywords": [
        "artificial intelligence",
        "pathfinding",
        "javascript",
        "json",
        "movingai"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.6.6",
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    },
    "license": "MIT"
}
